<% layout("/layouts/boilerplate") %>
<style>
#filters{
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.filter{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  margin-right: 1.8rem;
  margin-top: 1.5rem;
  opacity: 0.7;
  color: #222;
  text-decoration: none;
}
.filter:hover{
  opacity: 1;
  cursor: pointer;
}
.filter.active{
  opacity: 1;
  border-bottom: 2px solid #222;
}
.filter p{
  font-size: 0.8rem;
  margin-bottom: 0.5rem;
}

.tax-info{
  display: none;
}
.tax-toggle{
  border: 1px solid black;
  border-radius: 0.75rem;
  min-height: 3rem;
  padding: 0.75rem 1rem;
  margin-left: auto;
  display: flex;
  align-items: center;
  margin-top: 1.25rem;
}

.empty-listings {
  min-height: 50vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #555;
  margin: 0 auto;
}

.empty-listings > div {
  box-sizing: border-box;
  width: 100%;
  max-width: 24rem;
  padding: 0 1rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-listings h2 {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.empty-listings p {
  overflow-wrap: anywhere;
  margin-bottom: 1rem;
}

.results-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 1.5rem;
}

.results-bar p {
  margin: 0;
  color: #555;
}

.clear-filter {
  color: #222;
  font-size: 0.9rem;
}

@media (max-width: 576px) {
  #filters {
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  #filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    margin-right: 0;
    margin-top: 1rem;
    min-width: 3.75rem;
    flex: 0 0 auto;
  }

  .filter p {
    font-size: 0.72rem;
  }

  .tax-toggle {
    width: max-content;
    min-width: 16rem;
    margin-left: 0;
    margin-top: 1rem;
    flex-shrink: 0;
  }
}

</style>

<div id="filters">
<% for (let [key, category] of Object.entries(categories)) { %>
<a class="filter <%= activeCategory === key ? "active" : "" %>" href="/listings?category=<%= key %><%= searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : "" %>">
 <div><i class="<%= category.icon %>"></i></div>
<p><%= category.label %></p>
</a>
<% } %>
<div class="tax-toggle">
  <div class="form-check form-switch form-check-reverse">
    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
    <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
  </div>
</div>
</div>
<% if (resultMessage) { %>
<div class="results-bar">
  <p><%= resultMessage %> (<%= allListing.length %> result<%= allListing.length === 1 ? "" : "s" %>)</p>
  <a class="clear-filter" href="/listings">Clear filters</a>
</div>
<% } %>
<% if (allListing.length === 0) { %>
  <div class="empty-listings text-center mt-3">
    <div>
      <% if (resultMessage) { %>
        <h2>No stays found</h2>
        <p>Try another name or filter.</p>
        <a href="/listings" class="btn btn-dark add-btn">Clear filters</a>
      <% } else { %>
        <h2>No stays listed yet</h2>
        <p>Add your first vacation rental.</p>
        <a href="/listings/new" class="btn btn-dark add-btn">Add a listing</a>
      <% } %>
    </div>
  </div>
<% } else { %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
<% for (let listing of allListing) { %>
  <a href="/listings/<%= listing._id %>" class="listing-link">
<div class="card col listing-card" >
  <img src="<%=listing.image.url %>" class="card-img-top listing-index-img" alt="<%= listing.title %>">
  <div class="card-img-overlay"></div>
  
  
  <div class="card-body">
    <p class="card-text">
      <b><%= listing.title %></b> <br>
       &#X20B9; <%=listing.price.toLocaleString("en-IN") %> /night
       <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
    </p>    
  </div>
</div>
</a>
 <% }  %>
</div>
<% } %>


<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
   let taxInfo = document.getElementsByClassName("tax-info");
   for(let info of taxInfo){
    if(info.style.display != "inline"){
    info.style.display = "inline";
    }else{
      info.style.display = "none";
    }
   
   }
  });
</script>
